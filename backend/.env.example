DATABASE_URL=postgresql+psycopg://boso_user:PASSWORD_ANDA@localhost:5432/boso_jawa_db
APP_NAME=Boso Jawa AI
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173

# Gateway LLM OpenAI-compatible — isi dari dashboard Anda.
# JANGAN commit file .env ke repo.
AI_BASE_URL=https://griphubrouter.web.id/v1
AI_API_KEY=sk-ISI_DARI_DASHBOARD
# Model hemat token yang stabil: deepseek-v4-flash (credit ~0.01-0.04).
# Alternatif: glm-5.2, kimi-k2.6. Hindari tier pro/opus/sonnet (boros & lambat).
AI_MODEL=deepseek-v4-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=768
