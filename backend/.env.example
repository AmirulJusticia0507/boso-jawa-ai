DATABASE_URL=postgresql+psycopg://boso_user:postgres@localhost:5432/boso_jawa_db
APP_NAME=Boso Jawa AI
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173

# Gateway LLM OpenAI-compatible — isi dari dashboard Anda.
# JANGAN commit file .env ke repo.
AI_BASE_URL=https://griphubrouter.web.id/v1
AI_API_KEY=sk-ISI_DARI_DASHBOARD
# Model hemat token yang stabil: deepseek-v4-flash (credit ~0.01-0.04).
# Alternatif: glm-5.2, kimi-k2.6. Hindari tier pro/opus/sonnet (boros & lambat).
AI_MODEL=deepseek-v4-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=768

# --- Autentikasi admin (WAJIB) ---
# Kunci acak minimal 32 karakter untuk menandatangani JWT.
# Tanpa ini, seluruh autentikasi JWT ditolak (fail-closed).
JWT_SECRET_KEY=ISI_DENGAN_NILAI_ACAK_MINIMAL_32_KARAKTER

# Dipakai seed_db.py untuk membuat akun admin pertama.
# Tanpa ADMIN_SEED_PASSWORD, seeder TIDAK membuat akun admin.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ISI_PASSWORD_KUAT

# --- Rate limit ---
# Isi REDIS_URL atau pasangan UPSTASH_REST_URL + UPSTASH_REST_TOKEN untuk
# penghitung bersama. Tanpa itu, tiap instance serverless punya counter
# sendiri sehingga kuota efektif = limit x jumlah instance.
REDIS_URL=
UPSTASH_REST_URL=
UPSTASH_REST_TOKEN=
RATE_LIMIT_DEGRADE_POLICY=memory   # memory | reject (reject disarankan di produksi)
